<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!-- Inject the IconifyBundle source generator (shipped in this package's generator/ folder) as an
       analyzer, so a single reference to any IconifyBundle.<Pack> runs it. Analyzers don't flow through a
       transitive dependency, but this .targets does (it ships to buildTransitive/), and a manual @(Analyzer)
       add is honoured by the compiler. Added in a target (not props) so the add happens after items are
       evaluated; the same target name in build/ and buildTransitive/ means at most one definition wins, so
       it is added exactly once even when both are imported for a direct reference. -->
  <Target Name="AddIconifyBundleGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Include="$(MSBuildThisFileDirectory)..\generator\IconifyBundle.Generator.dll" />
    </ItemGroup>
  </Target>

  <!-- Raster settings for the generator, which renders the used icons into the assembly in Resource mode
       (and registers the files the Disk-mode task writes). Roslyn's analyzer config treats ';' and '#' as
       the start of a comment, so the lists are handed over comma-separated and the colour without its '#'.
       Set here, after the project body, so the project's own values are seen. -->
  <PropertyGroup>
    <_IconifyBundleRasterFormat>$(IconifyBundleRasterFormat.Replace(';', ','))</_IconifyBundleRasterFormat>
    <_IconifyBundleRasterSizes>$(IconifyBundleRasterSizes.Replace(';', ','))</_IconifyBundleRasterSizes>
    <_IconifyBundleRasterColor>$(IconifyBundleRasterColor.Replace('#', ''))</_IconifyBundleRasterColor>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="_IconifyBundleRasterFormat" />
    <CompilerVisibleProperty Include="_IconifyBundleRasterSizes" />
    <CompilerVisibleProperty Include="_IconifyBundleRasterColor" />
  </ItemGroup>

  <!-- Register the Disk-mode build task once, here, from the IconifyBundle package's tasks/ folder. Every
       pack pulls IconifyBundle in as a transitive dependency, so its build/buildTransitive .targets are
       imported into the consumer before the per-pack .targets run their <WriteUsedIcons /> invocation -
       meaning packs do not need to ship their own copy of IconifyBundle.Build.dll. -->
  <UsingTask TaskName="IconifyBundle.Build.WriteUsedIcons"
             AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\IconifyBundle.Build.dll" />

</Project>

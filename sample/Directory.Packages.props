<Project>
  <Import Project="..\Version.props" />
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- IconifyBundle packages (restored from the local ../nugets feed) -->
    <PackageVersion Include="IconifyBundle" Version="$(IconifyBundleVersion)" />
    <PackageVersion Include="IconifyBundle.Blazor" Version="$(IconifyBundleVersion)" />
    <PackageVersion Include="IconifyBundle.Feather" Version="$(IconifyBundleVersion)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Blazor WebAssembly -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests -->
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.65.1" />
  </ItemGroup>
</Project>

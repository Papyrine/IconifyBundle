<Project>
  <Import Project="..\Version.props" />
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- IconifyBundle packages (restored from the local ../nugets feed) -->
    <PackageVersion Include="IconifyBundle" Version="$(IconifyBundleVersion)" />
    <PackageVersion Include="IconifyBundle.Blazor" Version="$(IconifyBundleVersion)" />
    <PackageVersion Include="IconifyBundle.Feather" Version="$(IconifyBundleVersion)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Blazor WebAssembly -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests -->
    <PackageVersion Include="bunit" Version="2.12.5" />
    <PackageVersion Include="TUnit" Version="1.75.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>
</Project>

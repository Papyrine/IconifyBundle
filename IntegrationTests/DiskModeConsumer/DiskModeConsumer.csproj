<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Disk mode: only the referenced icons are written to the build output as .svg files, and the
         generator emits the file-path members (e.g. Feather.ActivityPath). Mutually exclusive with the
         default Resource mode. -->
    <IconifyBundleMode>Disk</IconifyBundleMode>
    <!-- Also render the referenced icons to PNG (the default format) at build time, written next to the
         .svg files as iconifybundle/feather/<size>/<name>.png, with Feather.ActivityPngPath(size) members. -->
    <IconifyBundleRasterSizes>16;24</IconifyBundleRasterSizes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="ProjectFiles" PrivateAssets="all" />
    <!-- A single pack reference suffices: the generator ships as an analyzer inside the pack. -->
    <PackageReference Include="IconifyBundle.Feather" />
  </ItemGroup>

</Project>
